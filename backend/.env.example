# Copy this file to `.env` and fill in real values for your machine.
# `.env` is git-ignored and must never be committed. This file is the
# committed contract: every key the app reads should be listed here.

# ---- Core Django ----
DEBUG=True
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me-with-a-generated-key
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----
# Leave DATABASE_URL unset in local dev: it falls back to SQLite at
# backend/db.sqlite3. Set it in staging/production, e.g.
# DATABASE_URL=postgres://user:password@localhost:5432/digimart

# ---- CORS ----
# Browser origins allowed to call this API (the Next.js dev server).
CORS_ALLOWED_ORIGINS=http://localhost:3000
